# Local party mode. This is the default and stores data in data/store.json.
DATA_BACKEND=local

# Required for real LAN use.
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=replace-this-with-a-long-random-string

# Firebase CLI mode uses the same Realtime Database project as the countdown app
# through the existing Firebase CLI login.
# Age-Game data stays separate under FIREBASE_DATA_ROOT/FIREBASE_GAME_ID/store.
# DATA_BACKEND=firebase-cli
# FIREBASE_PROJECT_ID=shawncountdown
# FIREBASE_DATABASE_URL=https://shawncountdown-default-rtdb.firebaseio.com
# FIREBASE_GAME_ID=party-bash-2026
# FIREBASE_DATA_ROOT=ageGames

# Admin SDK mode is also supported if you install firebase-admin and provide credentials.
# DATA_BACKEND=firebase
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# Alternative to FIREBASE_SERVICE_ACCOUNT_PATH:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Or use Application Default Credentials on the host:
# gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/optional/absolute/path/to/application_default_credentials.json
